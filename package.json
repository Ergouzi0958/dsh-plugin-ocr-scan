{
  "name": "@local/ocr-scan",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Scan pages and photos to Markdown with a cloud OCR model",
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "ocr",
    "markdown",
    "obsidian",
    "scan"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/<your-username>/dsh-plugin-ocr-scan.git"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
